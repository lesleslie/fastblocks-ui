{
  "description": "FastBlocks UI: HTML/CSS-first styling and component helpers for FastBlocks",
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.48.0",
    "@vitest/coverage-v8": "^1.6.0",
    "@vitest/ui": "^1.6.0",
    "axe-core": "^4.10.0",
    "chromatic": "^11.0.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.2.0",
    "serve": "^14.2.0",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "name": "fastblocks-ui",
  "scripts": {
    "format": "prettier --write fastblocks_ui/static/js/**/*.js",
    "lint": "eslint fastblocks_ui/static/js/**/*.js",
    "test": "vitest",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.js --project=accessibility",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:visual": "chromatic --build-script-name=build",
    "validate": "npm run lint && npm run test:run"
  },
  "type": "module",
  "version": "0.4.2"
}
